<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/accelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guest architecture:"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/archRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <RadioButton
            android:id="@+id/archArm64"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="ARM64" />

        <RadioButton
            android:id="@+id/archX86_64"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="x86_64 (AMD64)" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ports (leave blank for defaults; VNC/SPICE off unless set):"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/sshPortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="SSH port (default 2222)"
        android:inputType="number" />

    <EditText
        android:id="@+id/vncPortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="VNC port (blank = disabled)"
        android:inputType="number" />

    <EditText
        android:id="@+id/spicePortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="SPICE port (blank = disabled)"
        android:inputType="number" />

    <CheckBox
        android:id="@+id/headlessCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="Headless (-nographic, disable for VNC/SPICE display output)" />

    <Button
        android:id="@+id/startVmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Start VM" />

    <Button
        android:id="@+id/stopVmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Stop VM" />

    <Button
        android:id="@+id/openTerminalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Open Terminal" />

    <Button
        android:id="@+id/viewCommandButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="View Last Launch Command" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Import VM disk files (no adb needed; overwrites whichever image is currently loaded — import the file matching the arch selected above):"
        android:textSize="14sp" />

    <Button
        android:id="@+id/importDiskButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import rootfs.qcow2" />

    <Button
        android:id="@+id/importSeedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import seed.iso" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#33000000" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PRoot Container (lightweight, shares this device's kernel — ARM64 only, no boot/kernel/GUI, just a shell in a rootfs)"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/importRootfsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import PRoot rootfs (.tar.gz)" />

    <Button
        android:id="@+id/startProotButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Start PRoot Container" />

    <Button
        android:id="@+id/stopProotButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Stop PRoot Container" />

    <Button
        android:id="@+id/openProotTerminalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open PRoot Terminal" />

</LinearLayout>
</ScrollView>
