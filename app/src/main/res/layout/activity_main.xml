<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/accelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ports (leave blank for defaults; VNC/SPICE off unless set):"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/sshPortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="SSH port (default 2222)"
        android:inputType="number" />

    <EditText
        android:id="@+id/vncPortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="VNC port (blank = disabled)"
        android:inputType="number" />

    <EditText
        android:id="@+id/spicePortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="SPICE port (blank = disabled)"
        android:inputType="number" />

    <CheckBox
        android:id="@+id/headlessCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="Headless (-nographic, disable for VNC/SPICE display output)" />

    <Button
        android:id="@+id/startVmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Start VM" />

    <Button
        android:id="@+id/stopVmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Stop VM" />

    <Button
        android:id="@+id/openTerminalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Open Terminal" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Import VM disk files (no adb needed):"
        android:textSize="14sp" />

    <Button
        android:id="@+id/importDiskButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import rootfs.qcow2" />

    <Button
        android:id="@+id/importSeedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import seed.iso" />

</LinearLayout>
</ScrollView>
