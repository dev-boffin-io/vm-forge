<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/accelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/startVmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start VM (via Termux)" />

    <Button
        android:id="@+id/stopVmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Stop VM" />

    <Button
        android:id="@+id/startStandaloneButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Start VM (standalone, no Termux)" />

    <Button
        android:id="@+id/stopStandaloneButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Stop Standalone VM" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Import VM disk files (no adb needed):"
        android:textSize="14sp" />

    <Button
        android:id="@+id/importDiskButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import rootfs.qcow2" />

    <Button
        android:id="@+id/importSeedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Import seed.iso" />

    <Button
        android:id="@+id/viewLogButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="View VM Log" />

</LinearLayout>
</ScrollView>
